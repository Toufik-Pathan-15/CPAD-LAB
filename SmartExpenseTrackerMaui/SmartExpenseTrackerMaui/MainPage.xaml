<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SmartExpenseTrackerMaui.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Expense Tracker"
    BackgroundColor="#F3F6FC">

    <ContentPage.Resources>
        <Style x:Key="FieldStyle" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="#F8FAFC" />
            <Setter Property="TextColor" Value="#172554" />
            <Setter Property="PlaceholderColor" Value="#94A3B8" />
            <Setter Property="HeightRequest" Value="48" />
        </Style>

        <Style x:Key="CategoryStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#FFFFFF" />
            <Setter Property="TextColor" Value="#475569" />
            <Setter Property="BorderColor" Value="#E2E8F0" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,10" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <!-- Header -->
            <Grid ColumnDefinitions="*,60" Margin="0,8,0,0">
                <VerticalStackLayout Spacing="4">
                    <Label
                        Text="PERSONAL FINANCE"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="#64748B"
                        CharacterSpacing="1.5" />

                    <Label
                        Text="Expense Tracker"
                        FontSize="25"
                        FontAttributes="Bold"
                        TextColor="#172554" />

                    <Label
                        Text="Manage your daily spending"
                        FontSize="13"
                        TextColor="#64748B" />
                </VerticalStackLayout>

                <Border
                    Grid.Column="1"
                    BackgroundColor="#DCEBFF"
                    StrokeThickness="0"
                    WidthRequest="54"
                    HeightRequest="54"
                    StrokeShape="RoundRectangle 16"
                    VerticalOptions="Center">
                    <Label
                        Text="₹"
                        FontSize="28"
                        FontAttributes="Bold"
                        TextColor="#2563EB"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- Total dashboard -->
            <Border
                BackgroundColor="#245BE8"
                StrokeThickness="0"
                Padding="22"
                StrokeShape="RoundRectangle 22">

                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="TOTAL EXPENSES"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="#DBEAFE"
                        CharacterSpacing="1.3" />

                    <Label
                        x:Name="TotalLabel"
                        Text="₹0.00"
                        FontSize="36"
                        FontAttributes="Bold"
                        TextColor="White" />

                    <BoxView HeightRequest="1" Color="#6087F0" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            x:Name="TotalCountLabel"
                            Text="0 expenses recorded"
                            FontSize="13"
                            TextColor="#E0EAFF"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Column="1"
                            Text="↗"
                            FontSize="20"
                            TextColor="White" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Form heading -->
            <Grid ColumnDefinitions="*,Auto">
                <Label
                    Text="Add an expense"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="#172554"
                    VerticalOptions="Center" />

                <Label
                    Grid.Column="1"
                    Text="NEW ENTRY"
                    FontSize="10"
                    FontAttributes="Bold"
                    TextColor="#64748B"
                    VerticalOptions="Center" />
            </Grid>

            <!-- Expense form -->
            <Border
                BackgroundColor="White"
                Stroke="#E6ECF5"
                StrokeThickness="1"
                Padding="17"
                StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="Expense description"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="#172554" />

                    <Entry
                        x:Name="DescriptionEntry"
                        Placeholder="e.g. Lunch, Bus ticket"
                        MaxLength="80"
                        ReturnType="Next"
                        Style="{StaticResource FieldStyle}" />

                    <Label
                        Text="Amount (₹)"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="#172554"
                        Margin="0,5,0,0" />

                    <Entry
                        x:Name="AmountEntry"
                        Placeholder="0.00"
                        Keyboard="Numeric"
                        ReturnType="Done"
                        Style="{StaticResource FieldStyle}" />

                    <Label
                        Text="Category"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="#172554"
                        Margin="0,5,0,0" />

                    <Grid
                        ColumnDefinitions="*,*"
                        RowDefinitions="Auto,Auto"
                        ColumnSpacing="8"
                        RowSpacing="8">

                        <Button
                            x:Name="FoodButton"
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="🍔 Food"
                            Style="{StaticResource CategoryStyle}"
                            Clicked="OnFoodClicked" />

                        <Button
                            x:Name="TravelButton"
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="🚌 Travel"
                            Style="{StaticResource CategoryStyle}"
                            Clicked="OnTravelClicked" />

                        <Button
                            x:Name="ShoppingButton"
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="🛍 Shopping"
                            Style="{StaticResource CategoryStyle}"
                            Clicked="OnShoppingClicked" />

                        <Button
                            x:Name="OtherButton"
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="📦 Other"
                            Style="{StaticResource CategoryStyle}"
                            Clicked="OnOtherClicked" />
                    </Grid>

                    <Button
                        Text="+ Add Expense"
                        BackgroundColor="#245BE8"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="50"
                        Margin="0,8,0,0"
                        Clicked="OnAddExpenseClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- Recent expenses -->
            <Grid ColumnDefinitions="*,Auto">
                <Label
                    Text="Recent expenses"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="#172554"
                    VerticalOptions="Center" />

                <Border
                    Grid.Column="1"
                    BackgroundColor="#DCE8FF"
                    StrokeThickness="0"
                    Padding="10,4"
                    StrokeShape="RoundRectangle 14">
                    <Label
                        x:Name="ExpenseCountBadge"
                        Text="0"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="#1D4ED8" />
                </Border>
            </Grid>

            <!-- Empty list message -->
            <Border
                x:Name="EmptyState"
                BackgroundColor="White"
                Stroke="#E6ECF5"
                StrokeThickness="1"
                Padding="22"
                StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="🧾"
                        FontSize="30"
                        HorizontalOptions="Center" />

                    <Label
                        Text="No expenses yet"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#172554"
                        HorizontalOptions="Center" />

                    <Label
                        Text="Add your first expense above to get started."
                        FontSize="13"
                        TextColor="#64748B"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Expense cards are created in C# -->
            <VerticalStackLayout
                x:Name="ExpensesList"
                Spacing="10" />

            <Label
                Text="Smart Expense Tracker · Your money, organized."
                FontSize="11"
                TextColor="#94A3B8"
                HorizontalTextAlignment="Center"
                Margin="0,4,0,12" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>